---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: metabase-pgdata
  labels:
    app: metabase
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 10Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: metabase-plugins
  labels:
    app: metabase
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
apiVersion: v1
kind: Secret
metadata:
  name: metabase-secret
  labels:
    app: metabase
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME_DB_PASSWORD"
  MB_DB_PASS: "CHANGE_ME_DB_PASSWORD"
  MB_ENCRYPTION_SECRET_KEY: "CHANGE_ME_BASE64_32"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: metabase-config
  labels:
    app: metabase
data:
  MB_DB_TYPE: "postgres"
  MB_DB_DBNAME: "metabase"
  MB_DB_PORT: "5432"
  MB_DB_USER: "metabase"
  MB_DB_HOST: "127.0.0.1"
  MB_SITE_URL: "https://metabase.example.com"
  MB_JETTY_HOST: "0.0.0.0"
  MB_JETTY_PORT: "3000"
  MB_PLUGINS_DIR: "/plugins"
  JAVA_OPTS: "-Xmx2g -XX:+UseG1GC"
  JAVA_TIMEZONE: "Europe/Berlin"
  POSTGRES_DB: "metabase"
  POSTGRES_USER: "metabase"
  PGDATA: "/var/lib/postgresql/data/pgdata"
---
apiVersion: v1
kind: Pod
metadata:
  name: metabase
  labels:
    app: metabase
spec:
  restartPolicy: Always
  containers:

    # ---------------- Postgres (App-DB von Metabase) ----------------
    - name: postgres
      image: docker.io/library/postgres:16-alpine
      envFrom:
        - configMapRef:
            name: metabase-config
      env:
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: metabase-secret
              key: POSTGRES_PASSWORD
      volumeMounts:
        - name: pgdata
          mountPath: /var/lib/postgresql/data
      livenessProbe:
        exec:
          command:
            - /bin/sh
            - -c
            - pg_isready -U metabase -d metabase
        initialDelaySeconds: 20
        periodSeconds: 15
        timeoutSeconds: 5
        failureThreshold: 5

    # ---------------- Metabase ----------------
    - name: metabase
      image: docker.io/metabase/metabase:v0.62.4.3
      ports:
        - containerPort: 3000
          hostPort: 3000
          protocol: TCP
      envFrom:
        - configMapRef:
            name: metabase-config
      env:
        - name: MB_DB_PASS
          valueFrom:
            secretKeyRef:
              name: metabase-secret
              key: MB_DB_PASS
        - name: MB_ENCRYPTION_SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: metabase-secret
              key: MB_ENCRYPTION_SECRET_KEY
      volumeMounts:
        - name: plugins
          mountPath: /plugins
      livenessProbe:
        exec:
          command:
            - /bin/sh
            - -c
            - "curl -sf http://127.0.0.1:3000/api/health || exit 1"
        initialDelaySeconds: 180
        periodSeconds: 30
        timeoutSeconds: 10
        failureThreshold: 5

  volumes:
    - name: pgdata
      persistentVolumeClaim:
        claimName: metabase-pgdata
    - name: plugins
      persistentVolumeClaim:
        claimName: metabase-plugins


