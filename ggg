Im obigen Playbook wird "template:" genutzt. Dazu im Manifest ersetzen:

  stringData:
    POSTGRES_PASSWORD: "{{ '{{' }} postgres_password {{ '}}' }}"
    MB_DB_PASS: "{{ '{{' }} postgres_password {{ '}}' }}"
    MB_ENCRYPTION_SECRET_KEY: "{{ '{{' }} metabase_encryption_key {{ '}}' }}"

  data:
    MB_SITE_URL: "{{ '{{' }} metabase_site_url {{ '}}' }}"

  image: "{{ '{{' }} metabase_image {{ '}}' }}"

Alternativ: "copy:" statt "template:" verwenden und Secrets separat mit
"podman secret create" pflegen.


