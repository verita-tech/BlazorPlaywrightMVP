6. MANUELL AUF DEM SERVER (als User "metabase")
================================================================================

su - metabase

# Deploy / Redeploy
podman kube play --replace ~/manifests/metabase.yaml

# Abbauen
podman kube down ~/manifests/metabase.yaml

# Abbauen inkl. Volumes (ACHTUNG: Datenverlust)
podman kube down --force ~/manifests/metabase.yaml

# Status
podman pod ps
podman ps --pod
podman logs -f metabase-metabase
podman logs -f metabase-postgres

# In den Container
podman exec -it metabase-postgres psql -U metabase -d metabase

# Volumes
podman volume ls
podman volume inspect metabase-pgdata

# systemd (rootless)
systemctl --user status metabase.service
systemctl --user restart metabase.service
journalctl --user -u metabase.service -f

# Aus laufendem Pod wieder K8s-YAML generieren:
podman kube generate metabase -f /tmp/dump.yaml


