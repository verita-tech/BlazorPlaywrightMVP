---
# ---- Server / Netzwerk ----
# IP oder Hostname, ueber die Metabase erreichbar ist.
# MUSS exakt der URL entsprechen, die im Browser genutzt wird,
# sonst gibt es Redirect-Probleme beim Login.
metabase_server_ip: "192.168.1.50"
metabase_host_port: 3000
metabase_site_url: "http://{{ metabase_server_ip }}:{{ metabase_host_port }}"

# ---- Rootless User ----
podman_user: "metabase"
podman_uid: 2000
podman_home: "/home/metabase"
manifest_dir: "{{ podman_home }}/manifests"
pod_name: "metabase"

# ---- Images ----
metabase_image: "docker.io/metabase/metabase:v0.62.4.3"
postgres_image: "docker.io/library/postgres:16-alpine"

# ---- Metabase Runtime ----
metabase_db_name: "metabase"
metabase_db_user: "metabase"
metabase_java_opts: "-Xmx2g -XX:+UseG1GC"
metabase_timezone: "Europe/Berlin"

# ---- Storage ----
pgdata_size: "10Gi"
plugins_size: "1Gi"

# ---- Mapping Vault -> normale Variablen ----
# Konvention: vault_* nur in vault.yml, hier durchgereicht.
# Vorteil: man sieht auf einen Blick, was aus dem Vault kommt.
postgres_password: "{{ vault_postgres_password }}"
metabase_encryption_key: "{{ vault_metabase_encryption_key }}"
