5. AZURE DEVOPS - VORBEREITUNG
================================================================================

--------------------------------------------------------------------------------
5.1 SSH-Key fuer den Agent
--------------------------------------------------------------------------------

# Auf der Workstation ein dediziertes Deploy-Keypair erzeugen (ohne Passphrase,
# da der Agent unbeaufsichtigt laeuft):
ssh-keygen -t ed25519 -C "azdo-metabase-deploy" -f ~/.ssh/azdo_metabase -N ""

# Public Key auf den Zielserver:
ssh-copy-id -i ~/.ssh/azdo_metabase.pub ubuntu@192.168.1.50

# Testen:
ssh -i ~/.ssh/azdo_metabase ubuntu@192.168.1.50 'echo ok'

# Private Key in Azure DevOps hochladen:
#   Pipelines > Library > Secure files > + Secure file
#   Datei: ~/.ssh/azdo_metabase
#   Name : azdo_metabase
# Danach: Secure file > ... > Pipeline permissions > Zugriff fuer die Pipeline
# freigeben (sonst schlaegt DownloadSecureFile fehl).

--------------------------------------------------------------------------------
5.2 Variable Group
--------------------------------------------------------------------------------

Pipelines > Library > + Variable group
Name: metabase-deploy

  ANSIBLE_VAULT_PASSWORD   = <Vault-Passwort>      [Schloss-Icon = secret!]
  METABASE_SERVER_IP       = 192.168.1.50
  METABASE_SSH_USER        = ubuntu

# Optional: statt Klartext-Secret an Azure Key Vault anbinden
#   Variable group > Link secrets from an Azure key vault as variables
#   -> ANSIBLE_VAULT_PASSWORD kommt dann aus dem Key Vault.
# Das ist die sauberere Variante, wenn ein Key Vault existiert.

# Variable group > Pipeline permissions > Pipeline freigeben.

--------------------------------------------------------------------------------
5.3 Environment (fuer Approvals)
--------------------------------------------------------------------------------

Pipelines > Environments > New environment
Name: metabase-prod
  -> Approvals and checks > Approvals > Genehmiger eintragen

Damit haelt die Pipeline vor dem Deploy an und wartet auf Freigabe.

--------------------------------------------------------------------------------
5.4 Agent-Anforderungen
--------------------------------------------------------------------------------

Microsoft-hosted (ubuntu-latest):
  + Nichts zu warten, Ansible ist vorinstalliert
  - Braucht Netzwerkzugang zum Zielserver (bei internem LAN meist NICHT gegeben)

Self-hosted Agent:
  + Sieht das interne Netz
  - Muss selbst gepflegt werden
  Voraussetzungen: python3, python3-pip, openssh-client
  Ansible wird von der Pipeline per pip installiert (siehe unten).

Bei internem Zielserver: self-hosted Agent oder Azure DevOps Managed DevOps Pool
mit VNet-Anbindung. Der Pool-Name wird unten in "pool:" gesetzt.


================================================================================
6. AZURE PIPELINE
================================================================================

--------------------------------------------------------------------------------
azure-pipelines.yml
--------------------------------------------------------------------------------
trigger:
  branches:
    include:
      - main
  paths:
    include:
      - ansible/**
      - azure-pipelines.yml

pr: none

variables:
  - group: metabase-deploy          # ANSIBLE_VAULT_PASSWORD, METABASE_SERVER_IP, ...
  - name: ansibleDir
    value: '$(Build.SourcesDirectory)/ansible'

pool:
  # Microsoft-hosted:
  vmImage: 'ubuntu-latest'
  # Self-hosted (bei internem Zielserver):
  # name: 'MeinSelfHostedPool'
  # demands:
  #   - agent.os -equals Linux

stages:

# ============================================================
- stage: Validate
  displayName: 'Lint & Validate'
  jobs:
    - job: lint
      displayName: 'Syntax-Check'
      steps:

        - task: UsePythonVersion@0
          inputs:
            versionSpec: '3.11'

        - script: |
            set -e
            python -m pip install --upgrade pip
            pip install "ansible-core>=2.16" ansible-lint
            ansible-galaxy collection install -r requirements.yml
          workingDirectory: $(ansibleDir)
          displayName: 'Ansible installieren'

        - script: |
            set -e
            echo "$(ANSIBLE_VAULT_PASSWORD)" > $(Agent.TempDirectory)/.vault_pass
            chmod 600 $(Agent.TempDirectory)/.vault_pass
          displayName: 'Vault-Passwort bereitstellen'
          env:
            ANSIBLE_VAULT_PASSWORD: $(ANSIBLE_VAULT_PASSWORD)

        - script: |
            set -e
            ansible-playbook playbook.yml \
              --syntax-check \
              --vault-password-file $(Agent.TempDirectory)/.vault_pass \
              -i inventory.ini
          workingDirectory: $(ansibleDir)
          displayName: 'Syntax-Check'

        - script: |
            ansible-lint playbook.yml || true
          workingDirectory: $(ansibleDir)
          displayName: 'ansible-lint (nicht blockierend)'

        - script: |
            set -e
            ansible-vault view group_vars/vault.yml \
              --vault-password-file $(Agent.TempDirectory)/.vault_pass > /dev/null
            echo "Vault entschluesselbar."
          workingDirectory: $(ansibleDir)
          displayName: 'Vault-Zugriff pruefen'

        - script: rm -f $(Agent.TempDirectory)/.vault_pass
          condition: always()
          displayName: 'Vault-Passwort aufraeumen'

# ============================================================
- stage: Deploy
  displayName: 'Deploy auf Zielserver'
  dependsOn: Validate
  condition: succeeded()
  jobs:
    - deployment: deploy_metabase
      displayName: 'Metabase deployen'
      environment: 'metabase-prod'      # -> Approval greift hier
      strategy:
        runOnce:
          deploy:
            steps:

              - checkout: self

              - task: UsePythonVersion@0
                inputs:
                  versionSpec: '3.11'

              - script: |
                  set -e
                  python -m pip install --upgrade pip
                  pip install "ansible-core>=2.16"
                  ansible-galaxy collection install -r requirements.yml
                  ansible --version
                workingDirectory: $(ansibleDir)
                displayName: 'Ansible installieren'

              # ---- SSH-Key aus Secure Files ----
              - task: DownloadSecureFile@1
                name: sshKey
                displayName: 'SSH-Key laden'
                inputs:
                  secureFile: 'azdo_metabase'

              - script: |
                  set -e
                  mkdir -p ~/.ssh
                  chmod 700 ~/.ssh
                  cp "$(sshKey.secureFilePath)" ~/.ssh/azdo_metabase
                  chmod 600 ~/.ssh/azdo_metabase
                  ssh-keyscan -H "$(METABASE_SERVER_IP)" >> ~/.ssh/known_hosts 2>/dev/null || true
                displayName: 'SSH-Key einrichten'

              # ---- Vault-Passwort aus Secret Variable ----
              - script: |
                  set -e
                  printf '%s' "$ANSIBLE_VAULT_PASSWORD" > $(Agent.TempDirectory)/.vault_pass
                  chmod 600 $(Agent.TempDirectory)/.vault_pass
                displayName: 'Vault-Passwort bereitstellen'
                env:
                  ANSIBLE_VAULT_PASSWORD: $(ANSIBLE_VAULT_PASSWORD)

              # ---- Inventory dynamisch erzeugen ----
              - script: |
                  set -e
                  cat > $(Agent.TempDirectory)/inventory.ini <<EOF
                  [metabase]
                  mb-server ansible_host=$(METABASE_SERVER_IP) ansible_user=$(METABASE_SSH_USER)

                  [metabase:vars]
                  ansible_python_interpreter=/usr/bin/python3
                  ansible_ssh_private_key_file=~/.ssh/azdo_metabase
                  EOF
                  cat $(Agent.TempDirectory)/inventory.ini
                displayName: 'Inventory generieren'

              # ---- Erreichbarkeit ----
              - script: |
                  set -e
                  ansible metabase \
                    -i $(Agent.TempDirectory)/inventory.ini \
                    -m ping
                workingDirectory: $(ansibleDir)
                displayName: 'Zielserver erreichbar?'
                env:
                  ANSIBLE_HOST_KEY_CHECKING: 'False'

              # ---- Dry-Run ----
              - script: |
                  set -e
                  ansible-playbook playbook.yml \
                    -i $(Agent.TempDirectory)/inventory.ini \
                    --vault-password-file $(Agent.TempDirectory)/.vault_pass \
                    --check --diff \
                    -e "metabase_server_ip=$(METABASE_SERVER_IP)" \
                    -e "deploy_source=azure-devops-check" \
                    || echo "Check-Mode meldet Abweichungen (bei Erstinstallation normal)."
                workingDirectory: $(ansibleDir)
                displayName: 'Dry-Run (--check)'
                env:
                  ANSIBLE_HOST_KEY_CHECKING: 'False'
                  ANSIBLE_FORCE_COLOR: 'True'

              # ---- Deploy ----
              - script: |
                  set -e
                  ansible-playbook playbook.yml \
                    -i $(Agent.TempDirectory)/inventory.ini \
                    --vault-password-file $(Agent.TempDirectory)/.vault_pass \
                    -e "metabase_server_ip=$(METABASE_SERVER_IP)" \
                    -e "deploy_source=azure-devops (Build $(Build.BuildNumber))"
                workingDirectory: $(ansibleDir)
                displayName: 'Playbook ausfuehren'
                env:
                  ANSIBLE_HOST_KEY_CHECKING: 'False'
                  ANSIBLE_FORCE_COLOR: 'True'

              # ---- Smoke Test ----
              - script: |
                  set -e
                  URL="http://$(METABASE_SERVER_IP):3000/api/health"
                  for i in $(seq 1 30); do
                    if curl -sf "$URL" > /dev/null; then
                      echo "Metabase gesund: $URL"
                      exit 0
                    fi
                    echo "Versuch $i/30 - warte 10s..."
                    sleep 10
                  done
                  echo "Health-Check fehlgeschlagen."
                  exit 1
                displayName: 'Smoke Test'

              # ---- Aufraeumen ----
              - script: |
                  rm -f $(Agent.TempDirectory)/.vault_pass
                  rm -f ~/.ssh/azdo_metabase
                  rm -f $(Agent.TempDirectory)/inventory.ini
                condition: always()
                displayName: 'Secrets aufraeumen'


