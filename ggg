# Rootless-User, unter dem Metabase laeuft
podman_user: "metabase"
podman_uid: 2000
podman_home: "/home/metabase"

manifest_dir: "{{ podman_home }}/manifests"
pod_name: "metabase"

metabase_image: "docker.io/metabase/metabase:v0.62.4.3"
postgres_image: "docker.io/library/postgres:16-alpine"
metabase_site_url: "https://metabase.example.com"
metabase_host_port: 3000

# ACHTUNG: rootless kann standardmaessig keine Ports <1024 binden.
# 3000 ist unproblematisch. Reverse Proxy (Caddy/nginx) davor fuer 80/443.

# Besser via ansible-vault:
#   ansible-vault encrypt_string 'geheim' --name 'postgres_password'
postgres_password: "CHANGE_ME_DB_PASSWORD"
metabase_encryption_key: "CHANGE_ME_BASE64_32"

--------------------------------------------------------------------------------
ansible/playbook.yml
--------------------------------------------------------------------------------
---
- name: Metabase via podman kube play (rootless) auf Ubuntu deployen
  hosts: metabase
  become: true

  tasks:
    # ---------- Pakete ----------
    - name: APT Cache aktualisieren
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: 3600

    - name: Podman + Abhaengigkeiten installieren
      ansible.builtin.apt:
        name:
          - podman
          - uidmap
          - slirp4netns
          - fuse-overlayfs
          - passt
          - dbus-user-session
          - curl
        state: present

    - name: Podman Version pruefen (>= 4.4 fuer kube play Features)
      ansible.builtin.command: podman --version
      register: podman_version
      changed_when: false

    - name: Version ausgeben
      ansible.builtin.debug:
        var: podman_version.stdout

    # ---------- Rootless User ----------
    - name: Service-User anlegen
      ansible.builtin.user:
        name: "{{ podman_user }}"
        uid: "{{ podman_uid }}"
        home: "{{ podman_home }}"
        shell: /bin/bash
        create_home: true
        state: present

    - name: subuid/subgid setzen
      ansible.builtin.lineinfile:
        path: "{{ item.file }}"
        regexp: "^{{ podman_user }}:"
        line: "{{ podman_user }}:200000:65536"
        create: true
      loop:
        - { file: /etc/subuid }
        - { file: /etc/subgid }

    - name: Linger aktivieren (Pod laeuft ohne aktive Session weiter)
      ansible.builtin.command: "loginctl enable-linger {{ podman_user }}"
      args:
        creates: "/var/lib/systemd/linger/{{ podman_user }}"

    - name: Manifest-Verzeichnis anlegen
      ansible.builtin.file:
        path: "{{ manifest_dir }}"
        state: directory
        owner: "{{ podman_user }}"
        group: "{{ podman_user }}"
        mode: "0750"

    # ---------- Manifest ausbringen ----------
    - name: Manifest auf Server kopieren (mit Variablen)
      ansible.builtin.template:
        src: ../manifests/metabase.yaml
        dest: "{{ manifest_dir }}/metabase.yaml"
        owner: "{{ podman_user }}"
        group: "{{ podman_user }}"
        mode: "0640"
      register: manifest_file

    # ---------- Deploy ----------
    - name: Images vorziehen
      become_user: "{{ podman_user }}"
      ansible.builtin.command: "podman pull {{ item }}"
      loop:
        - "{{ metabase_image }}"
        - "{{ postgres_image }}"
      register: pull_result
      changed_when: "'Copying' in pull_result.stdout"
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"

    - name: Pod deployen / aktualisieren
      become_user: "{{ podman_user }}"
      ansible.builtin.command: >
        podman kube play --replace
        {{ manifest_dir }}/metabase.yaml
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"
      register: kube_play
      changed_when: true

    - name: Play-Ausgabe
      ansible.builtin.debug:
        var: kube_play.stdout_lines

    # ---------- systemd Unit (Autostart nach Reboot) ----------
    - name: systemd user-Verzeichnis anlegen
      ansible.builtin.file:
        path: "{{ podman_home }}/.config/systemd/user"
        state: directory
        owner: "{{ podman_user }}"
        group: "{{ podman_user }}"
        mode: "0755"

    - name: Quadlet .kube Unit schreiben
      ansible.builtin.copy:
        dest: "{{ podman_home }}/.config/containers/systemd/metabase.kube"
        owner: "{{ podman_user }}"
        group: "{{ podman_user }}"
        mode: "0644"
        content: |
          [Unit]
          Description=Metabase Pod (podman kube play)
          After=network-online.target
          Wants=network-online.target

          [Kube]
          Yaml={{ manifest_dir }}/metabase.yaml
          PublishPort={{ metabase_host_port }}:3000

          [Service]
          Restart=always
          TimeoutStartSec=900

          [Install]
          WantedBy=default.target
      register: quadlet

    - name: systemd user daemon-reload
      become_user: "{{ podman_user }}"
      ansible.builtin.systemd:
        daemon_reload: true
        scope: user
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"

    - name: Service aktivieren + starten
      become_user: "{{ podman_user }}"
      ansible.builtin.systemd:
        name: metabase.service
        state: started
        enabled: true
        scope: user
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"

    # ---------- Health Check ----------
    - name: Auf Metabase-Health warten (bis 5 min)
      ansible.builtin.uri:
        url: "http://127.0.0.1:{{ metabase_host_port }}/api/health"
        status_code: 200
      register: health
      until: health.status == 200
      retries: 30
      delay: 10

    - name: Status
      become_user: "{{ podman_user }}"
      ansible.builtin.command: "podman pod ps --filter name={{ pod_name }}"
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"
      register: pod_status
      changed_when: false

    - name: Ergebnis
      ansible.builtin.debug:
        var: pod_status.stdout_lines


