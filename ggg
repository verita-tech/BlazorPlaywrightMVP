1. VAULT ANLEGEN
================================================================================

cd metabase-podman/ansible

# Encryption Key generieren (EINMALIG! Danach nie aendern, sonst sind alle
# in Metabase gespeicherten DB-Credentials unbrauchbar):
openssl rand -base64 32

# Vault-Datei erstellen:
ansible-vault create group_vars/vault.yml

# Inhalt von group_vars/vault.yml (im Editor eingeben):
---
vault_postgres_password: "EinLangesSicheresPasswort123!"
vault_metabase_encryption_key: "<Ausgabe von openssl rand -base64 32>"
vault_metabase_admin_email: "admin@example.com"

# Spaeter bearbeiten:
ansible-vault edit group_vars/vault.yml

# Ansehen:
ansible-vault view group_vars/vault.yml

# Passwort aendern:
ansible-vault rekey group_vars/vault.yml

# Optional: Vault-Passwort in Datei (bequemer, aber schuetzen!)
echo "meinVaultPasswort" > .vault_pass
chmod 600 .vault_pass
echo ".vault_pass" >> ../.gitignore


