3. K8S MANIFEST ALS TEMPLATE
================================================================================

--------------------------------------------------------------------------------
ansible/templates/metabase.yaml.j2
--------------------------------------------------------------------------------
# ACHTUNG: generiert von Ansible - nicht manuell auf dem Server editieren!
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: metabase-pgdata
  labels:
    app: metabase
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ pgdata_size }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: metabase-plugins
  labels:
    app: metabase
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: {{ plugins_size }}
---
apiVersion: v1
kind: Secret
metadata:
  name: metabase-secret
  labels:
    app: metabase
type: Opaque
stringData:
  POSTGRES_PASSWORD: {{ postgres_password | quote }}
  MB_DB_PASS: {{ postgres_password | quote }}
  MB_ENCRYPTION_SECRET_KEY: {{ metabase_encryption_key | quote }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: metabase-config
  labels:
    app: metabase
data:
  # ---- Metabase App-DB ----
  MB_DB_TYPE: "postgres"
  MB_DB_DBNAME: {{ metabase_db_name | quote }}
  MB_DB_PORT: "5432"
  MB_DB_USER: {{ metabase_db_user | quote }}
  # 127.0.0.1 funktioniert, weil beide Container im selben Pod
  # denselben Netzwerk-Namespace teilen (Ersatz fuer Service-DNS)
  MB_DB_HOST: "127.0.0.1"

  # ---- Jetty: HTTP only, kein TLS ----
  MB_JETTY_HOST: "0.0.0.0"
  MB_JETTY_PORT: "3000"
  MB_SITE_URL: {{ metabase_site_url | quote }}

  # ---- Runtime ----
  MB_PLUGINS_DIR: "/plugins"
  MB_ADMIN_EMAIL: {{ metabase_admin_email | quote }}
  JAVA_OPTS: {{ metabase_java_opts | quote }}
  JAVA_TIMEZONE: {{ metabase_timezone | quote }}
  MB_ANON_TRACKING_ENABLED: "false"

  # ---- Postgres Container ----
  POSTGRES_DB: {{ metabase_db_name | quote }}
  POSTGRES_USER: {{ metabase_db_user | quote }}
  PGDATA: "/var/lib/postgresql/data/pgdata"
---
apiVersion: v1
kind: Pod
metadata:
  name: {{ pod_name }}
  labels:
    app: metabase
spec:
  restartPolicy: Always
  containers:

    # ---------------- Postgres (App-DB von Metabase) ----------------
    - name: postgres
      image: {{ postgres_image }}
      envFrom:
        - configMapRef:
            name: metabase-config
      env:
        - name: POSTGRES_PASSWORD
          valueFrom:
            secretKeyRef:
              name: metabase-secret
              key: POSTGRES_PASSWORD
      volumeMounts:
        - name: pgdata
          mountPath: /var/lib/postgresql/data
      livenessProbe:
        exec:
          command:
            - /bin/sh
            - -c
            - "pg_isready -U {{ metabase_db_user }} -d {{ metabase_db_name }}"
        initialDelaySeconds: 20
        periodSeconds: 15
        timeoutSeconds: 5
        failureThreshold: 5

    # ---------------- Metabase ----------------
    - name: metabase
      image: {{ metabase_image }}
      ports:
        - containerPort: 3000
          hostPort: {{ metabase_host_port }}
          protocol: TCP
      envFrom:
        - configMapRef:
            name: metabase-config
      env:
        - name: MB_DB_PASS
          valueFrom:
            secretKeyRef:
              name: metabase-secret
              key: MB_DB_PASS
        - name: MB_ENCRYPTION_SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: metabase-secret
              key: MB_ENCRYPTION_SECRET_KEY
      volumeMounts:
        - name: plugins
          mountPath: /plugins
      livenessProbe:
        exec:
          command:
            - /bin/sh
            - -c
            - "curl -sf http://127.0.0.1:3000/api/health || exit 1"
        initialDelaySeconds: 180
        periodSeconds: 30
        timeoutSeconds: 10
        failureThreshold: 5

  volumes:
    - name: pgdata
      persistentVolumeClaim:
        claimName: metabase-pgdata
    - name: plugins
      persistentVolumeClaim:
        claimName: metabase-plugins


================================================================================
4. PLAYBOOK
================================================================================

--------------------------------------------------------------------------------
ansible/playbook.yml
--------------------------------------------------------------------------------
---
- name: Metabase via podman kube play (rootless, HTTP) auf Ubuntu deployen
  hosts: metabase
  become: true

  vars_files:
    - group_vars/vault.yml

  tasks:

    # ---------- Vorbedingungen ----------
    - name: Pruefen ob Vault-Variablen gesetzt sind
      ansible.builtin.assert:
        that:
          - vault_postgres_password is defined
          - vault_postgres_password | length >= 12
          - vault_metabase_encryption_key is defined
          - vault_metabase_encryption_key | length >= 32
        fail_msg: >
          Vault-Variablen fehlen oder sind zu kurz.
          Bitte 'ansible-vault edit group_vars/vault.yml' pruefen.
        quiet: true

    # ---------- Pakete ----------
    - name: APT Cache aktualisieren
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: 3600

    - name: Podman + Abhaengigkeiten installieren
      ansible.builtin.apt:
        name:
          - podman
          - uidmap
          - slirp4netns
          - fuse-overlayfs
          - passt
          - dbus-user-session
          - curl
        state: present

    - name: Podman Version ermitteln
      ansible.builtin.command: podman version --format '{{ "{{" }}.Client.Version{{ "}}" }}'
      register: podman_version
      changed_when: false

    - name: Podman Version anzeigen
      ansible.builtin.debug:
        msg: "Podman {{ podman_version.stdout }} (Quadlet benoetigt >= 4.4)"

    # ---------- Rootless Service-User ----------
    - name: Service-User anlegen
      ansible.builtin.user:
        name: "{{ podman_user }}"
        uid: "{{ podman_uid }}"
        home: "{{ podman_home }}"
        shell: /bin/bash
        create_home: true
        state: present

    - name: subuid/subgid setzen
      ansible.builtin.lineinfile:
        path: "{{ item }}"
        regexp: "^{{ podman_user }}:"
        line: "{{ podman_user }}:200000:65536"
        create: true
        mode: "0644"
      loop:
        - /etc/subuid
        - /etc/subgid
      notify: migrate podman system

    - name: Linger aktivieren (Pod laeuft ohne aktive Session weiter)
      ansible.builtin.command: "loginctl enable-linger {{ podman_user }}"
      args:
        creates: "/var/lib/systemd/linger/{{ podman_user }}"

    - name: Verzeichnisse anlegen
      ansible.builtin.file:
        path: "{{ item }}"
        state: directory
        owner: "{{ podman_user }}"
        group: "{{ podman_user }}"
        mode: "0750"
      loop:
        - "{{ manifest_dir }}"
        - "{{ podman_home }}/.config/containers/systemd"

    # ---------- Manifest aus Template rendern ----------
    - name: Manifest rendern (Secrets aus Vault)
      ansible.builtin.template:
        src: templates/metabase.yaml.j2
        dest: "{{ manifest_dir }}/metabase.yaml"
        owner: "{{ podman_user }}"
        group: "{{ podman_user }}"
        mode: "0600"      # enthaelt Secrets -> nur der Service-User
      no_log: true        # Diff nicht ins Log schreiben
      register: manifest_file

    # ---------- Images ----------
    - name: Images ziehen
      become_user: "{{ podman_user }}"
      ansible.builtin.command: "podman pull {{ item }}"
      loop:
        - "{{ metabase_image }}"
        - "{{ postgres_image }}"
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"
      register: pull_result
      changed_when: "'Copying' in pull_result.stdout or 'Writing' in pull_result.stdout"

    # ---------- Quadlet Unit (Autostart) ----------
    - name: Quadlet .kube Unit schreiben
      ansible.builtin.copy:
        dest: "{{ podman_home }}/.config/containers/systemd/metabase.kube"
        owner: "{{ podman_user }}"
        group: "{{ podman_user }}"
        mode: "0644"
        content: |
          [Unit]
          Description=Metabase Pod (podman kube play)
          After=network-online.target
          Wants=network-online.target

          [Kube]
          Yaml={{ manifest_dir }}/metabase.yaml

          [Service]
          Restart=always
          TimeoutStartSec=900

          [Install]
          WantedBy=default.target
      register: quadlet

    - name: systemd user daemon-reload
      become_user: "{{ podman_user }}"
      ansible.builtin.systemd:
        daemon_reload: true
        scope: user
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"
      when: quadlet.changed or manifest_file.changed

    - name: Service neu starten bei Aenderung
      become_user: "{{ podman_user }}"
      ansible.builtin.systemd:
        name: metabase.service
        state: restarted
        enabled: true
        scope: user
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"
      when: quadlet.changed or manifest_file.changed

    - name: Service sicherstellen (falls keine Aenderung)
      become_user: "{{ podman_user }}"
      ansible.builtin.systemd:
        name: metabase.service
        state: started
        enabled: true
        scope: user
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"

    # ---------- Health Check ----------
    - name: Auf Metabase-Health warten (bis 5 min, Erststart dauert)
      ansible.builtin.uri:
        url: "http://127.0.0.1:{{ metabase_host_port }}/api/health"
        status_code: 200
      register: health
      until: health.status == 200
      retries: 30
      delay: 10

    - name: Pod-Status
      become_user: "{{ podman_user }}"
      ansible.builtin.command: "podman pod ps --filter name={{ pod_name }}"
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"
      register: pod_status
      changed_when: false

    - name: Ergebnis
      ansible.builtin.debug:
        msg:
          - "{{ pod_status.stdout_lines }}"
          - "Metabase erreichbar unter: {{ metabase_site_url }}"

  handlers:
    - name: migrate podman system
      become_user: "{{ podman_user }}"
      ansible.builtin.command: podman system migrate
      environment:
        XDG_RUNTIME_DIR: "/run/user/{{ podman_uid }}"


