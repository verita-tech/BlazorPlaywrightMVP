public sealed class MetabaseMcpOptions
{
    // Built-in Metabase MCP server, Streamable HTTP transport.
    // e.g. https://your-metabase.example.com/api/mcp
    public string Endpoint { get; set; } = "";

    // OAuth (Dynamic Client Registration): no ClientId needed, the SDK registers itself.
    public string ClientName { get; set; } = "TalkToData";

    // Must match a redirect endpoint served by this app, e.g.
    // https://localhost:7123/oauth/callback
    public string RedirectUri { get; set; } = "";

    // DANGER: skip TLS certificate validation for the Metabase connection
