        {
            <FluentTabs @bind-ActiveTabId="_activeTab" Style="margin-top:16px;">
                <FluentTab Id="chart" Label="Diagramm">
                    <BarChart Columns="_answer.Columns" Rows="_answer.Rows" />
                </FluentTab>
                <FluentTab Id="table" Label="Tabelle">
                    <FluentDataGrid Items="@GridRows" GridTemplateColumns="@GridTemplate">
                        @for (var i = 0; i < _answer.Columns.Count; i++)
                        {
