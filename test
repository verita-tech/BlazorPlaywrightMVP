<h1>Talk to Data</h1>
<p class="sub">Frag deine Metabase-Daten in normaler Sprache. Antwort als Text oder Diagramm.</p>

<div class="ask">
    <input @bind="_question" @bind:event="oninput" @onkeydown="OnKey"
           placeholder="z. B. Umsatz pro Monat in den letzten 6 Monaten" />
    <button @onclick="Ask" disabled="@_busy">
        @(_busy ? "Frage läuft…" : "Fragen")
    </button>
</div>

@if (_busy)
{
    <div class="hint">Metabase wird über MCP abgefragt…</div>
}

@if (_answer is not null)
{
    @if (_answer.Error is not null)
    {
        <div class="error">
            <strong>Fehler:</strong> @_answer.Error
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_answer.Text))
        {
            <div class="answer">@_answer.Text</div>
        }

        @if (_answer.HasTable)
        {
            <div class="toggle">
                <button class="@(_view == View.Chart ? "on" : "")" @onclick="() => _view = View.Chart">Diagramm</button>
                <button class="@(_view == View.Table ? "on" : "")" @onclick="() => _view = View.Table">Tabelle</button>
            </div>

            @if (_view == View.Chart)
            {
                <BarChart Columns="_answer.Columns" Rows="_answer.Rows" />
            }
            else
            {
                <div class="tablewrap">
                    <table>
                        <thead>
                            <tr>@foreach (var c in _answer.Columns) { <th>@c</th> }</tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _answer.Rows)
                            {
                                <tr>@foreach (var cell in r) { <td>@cell</td> }</tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
}

@code {
    private enum View { Chart, Table }

    private string _question = "";
    private bool _busy;
    private DataAnswer? _answer;
    private View _view = View.Chart;

    private async Task Ask()
    {
        if (string.IsNullOrWhiteSpace(_question) || _busy) return;
        _busy = true;
        _answer = null;
        try
        {
            _answer = await Data.AskAsync(_question);
            _view = _answer.HasTable ? View.Chart : View.Table;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Ask();
    }
}


