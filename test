@* Simple dependency-free bar chart. Takes a label column + a numeric column. *@

@if (_bars.Count > 0)
{
    <svg class="chart" viewBox="0 0 @Width @Height" preserveAspectRatio="xMidYMid meet" role="img"
         aria-label="Balkendiagramm der Ergebnisse">
        @{
            var max = _bars.Max(b => b.Value);
            if (max <= 0) max = 1;
            var n = _bars.Count;
            var gap = 10.0;
            var barW = (Width - Pad * 2 - gap * (n - 1)) / n;
            var chartH = Height - Pad * 2;
        }
        @for (var i = 0; i < _bars.Count; i++)
        {
            var b = _bars[i];
            var h = chartH * (b.Value / max);
            var x = Pad + i * (barW + gap);
            var y = Height - Pad - h;
            <rect x="@F(x)" y="@F(y)" width="@F(barW)" height="@F(h)" rx="4" class="bar" />
            <text x="@F(x + barW / 2)" y="@F(Height - Pad + 14)" class="lbl" text-anchor="middle">@Trim(b.Label)</text>
            <text x="@F(x + barW / 2)" y="@F(y - 4)" class="val" text-anchor="middle">@b.Value.ToString("0.##")</text>
        }
    </svg>
}

@code {
    [Parameter] public List<string> Columns { get; set; } = new();
    [Parameter] public List<List<object?>> Rows { get; set; } = new();

    const double Width = 720, Height = 320, Pad = 40;

    private record Bar(string Label, double Value);
    private List<Bar> _bars = new();

    protected override void OnParametersSet()
    {
        _bars = new();
        if (Columns.Count < 2 || Rows.Count == 0) return;

        // Pick first non-numeric column as label, first numeric column as value.
        int labelIdx = 0, valueIdx = -1;
        for (var c = 0; c < Columns.Count; c++)
        {
            if (IsNumeric(Rows[0].ElementAtOrDefault(c))) { valueIdx = c; break; }
        }
        if (valueIdx == -1) return;
        if (valueIdx == 0) labelIdx = Columns.Count > 1 ? 1 : 0;

        foreach (var r in Rows.Take(15))
        {
            var label = r.ElementAtOrDefault(labelIdx)?.ToString() ?? "";
            if (double.TryParse(r.ElementAtOrDefault(valueIdx)?.ToString(),
                    System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var v))
                _bars.Add(new Bar(label, v));
        }
    }

    private static bool IsNumeric(object? o) =>
        o is not null && double.TryParse(o.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out _);

    private static string F(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string Trim(string s) => s.Length > 12 ? s[..11] + "…" : s;
}


