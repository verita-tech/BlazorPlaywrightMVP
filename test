using TalkToData.Components;
using TalkToData.Services;

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddRazorComponents()
    .AddInteractiveServerComponents();

builder.Services.Configure<AnthropicOptions>(builder.Configuration.GetSection("Anthropic"));
builder.Services.Configure<MetabaseMcpOptions>(builder.Configuration.GetSection("MetabaseMcp"));

// One MCP/Anthropic connection per circuit (user session) is a sensible default.
builder.Services.AddScoped<TalkToDataService>();

var app = builder.Build();

if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Error", createScopeForErrors: true);
    app.UseHsts();
}

app.UseHttpsRedirection();
app.UseAntiforgery();
app.MapStaticAssets();

