using System.Text.Json;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Options;
using ModelContextProtocol.Authentication;
using ModelContextProtocol.Client;
using OllamaSharp;

namespace TalkToData.Services;

/// <summary>Result of one "talk to data" turn.</summary>
public sealed class DataAnswer
{
    public string Text { get; set; } = "";
    public List<string> Columns { get; set; } = new();
    public List<List<object?>> Rows { get; set; } = new();
    public bool HasTable => Columns.Count > 0 && Rows.Count > 0;
    public string? Error { get; set; }
}

public sealed class TalkToDataService : IAsyncDisposable
{
    private readonly OllamaOptions _ollama;
    private readonly MetabaseMcpOptions _mb;
    private readonly MetabaseOAuthCoordinator _oauth;
    private readonly ILogger<TalkToDataService> _log;

    private McpClient? _mcp;
    private IChatClient? _chat;
    private IList<McpClientTool>? _mcpTools;
    private HttpClient? _httpClient;

    private DataAnswer? _current;

    public TalkToDataService(
        IOptions<OllamaOptions> ollama,
        IOptions<MetabaseMcpOptions> mb,
        MetabaseOAuthCoordinator oauth,
        ILogger<TalkToDataService> log)
    {
        _ollama = ollama.Value;
        _mb = mb.Value;
        _oauth = oauth;
        _log = log;
    }

    private async Task EnsureConnectedAsync(CancellationToken ct)
    {
        if (_mcp is not null) return;

        // Optional TLS bypass for self-signed / internal-CA Metabase instances.
        var httpHandler = new HttpClientHandler();
        if (_mb.IgnoreSslErrors)
        {
            _log.LogWarning("TLS certificate validation is DISABLED for the Metabase connection.");
            httpHandler.ServerCertificateCustomValidationCallback =
                HttpClientHandler.DangerousAcceptAnyServerCertificateValidator;
        }
        _httpClient = new HttpClient(httpHandler);

        var oauthOptions = new ClientOAuthOptions
        {
            ClientName = _mb.ClientName,
            RedirectUri = new Uri(_mb.RedirectUri),
            // Metabase uses Dynamic Client Registration, so no ClientId is set here.
            // SDK 2.x: use AuthorizationCallbackHandler (AuthorizationRedirectDelegate is deprecated).
            AuthorizationCallbackHandler = async (authUrl, redirectUri, ct2) =>
            {
                // Extract the `state` we must round-trip back from the browser.
                var query = System.Web.HttpUtility.ParseQueryString(authUrl.Query);
                var state = query["state"] ?? Guid.NewGuid().ToString("N");

                var result = await _oauth.WaitForCodeAsync(authUrl, state, ct2);
                return new AuthorizationCallbackResult(result.Code, result.State, result.Issuer);
            }
        };

        // Streamable HTTP transport to Metabase's built-in MCP endpoint, with the
        // (optionally cert-ignoring) HttpClient and OAuth attached.
        var transport = new HttpClientTransport(
            new HttpClientTransportOptions
            {
                Name = "Metabase",
                Endpoint = new Uri(_mb.Endpoint),
                TransportMode = HttpTransportMode.AutoDetect,
                OAuth = oauthOptions
            },
            _httpClient);

        _mcp = await McpClient.CreateAsync(transport, cancellationToken: ct);
        _mcpTools = await _mcp.ListToolsAsync(cancellationToken: ct);

        var ollama = new OllamaApiClient(new Uri(_ollama.Endpoint), _ollama.Model);
        _chat = new ChatClientBuilder(ollama)
            .Use(inner => new TableSniffingChatClient(inner, () => _current))
            .UseFunctionInvocation()
            .Build();

        _log.LogInformation("Connected to Metabase MCP. Tools: {Tools}",
            string.Join(", ", _mcpTools.Select(t => t.Name)));
    }

    public async Task<DataAnswer> AskAsync(string question, CancellationToken ct = default)
    {
        var answer = new DataAnswer();
        _current = answer;
        try
        {
            await EnsureConnectedAsync(ct);

            var messages = new List<ChatMessage>
            {
                new(ChatRole.System,
                    """
                    You are a data analyst connected to Metabase via tools.
                    Use the tools to search for the right table/metric, build and
                    execute a query, then answer the user's question.
                    Keep tabular results small and relevant (aggregate/limit rows)
                    so they can be charted. Explain the result briefly in the
                    user's language (German if the question is German).
                    """),
                new(ChatRole.User, question)
            };

            var options = new ChatOptions
            {
                Tools = [.. _mcpTools!],
                ModelId = _ollama.Model,
                Temperature = 0.1f
            };

            var response = await _chat!.GetResponseAsync(messages, options, ct);
            answer.Text = response.Text;

            if (string.IsNullOrWhiteSpace(answer.Text))
                answer.Text = "Ich konnte keine textliche Antwort erzeugen.";
        }
        catch (Exception ex)
        {
            _log.LogError(ex, "Talk-to-data failed");
            answer.Error = ex.Message;
        }
        finally
        {
            _current = null;
        }
        return answer;
    }

    /// <summary>
    /// Best-effort: pull rows/columns out of an MCP tool result payload.
    /// Metabase query results usually come back as JSON with a "data" object
    /// containing "cols" and "rows". We also handle a plain array of objects.
    /// </summary>
    internal static void TryExtractTable(string payload, DataAnswer answer)
    {
        if (answer.HasTable || string.IsNullOrWhiteSpace(payload)) return;

        try
        {
            using var doc = JsonDocument.Parse(payload);
            var root = doc.RootElement;

            var data = root.ValueKind == JsonValueKind.Object && root.TryGetProperty("data", out var d)
                ? d : root;

            if (data.ValueKind == JsonValueKind.Object &&
                data.TryGetProperty("rows", out var rowsEl) &&
                rowsEl.ValueKind == JsonValueKind.Array)
            {
                if (data.TryGetProperty("cols", out var colsEl) && colsEl.ValueKind == JsonValueKind.Array)
                {
                    foreach (var c in colsEl.EnumerateArray())
                        answer.Columns.Add(
                            c.TryGetProperty("display_name", out var dn) ? dn.GetString() ?? "" :
                            c.TryGetProperty("name", out var nm) ? nm.GetString() ?? "" : "col");
                }

                foreach (var r in rowsEl.EnumerateArray())
                {
                    var row = new List<object?>();
                    foreach (var cell in r.EnumerateArray())
                        row.Add(CellValue(cell));
                    answer.Rows.Add(row);
                }
                return;
            }

            if (root.ValueKind == JsonValueKind.Array && root.GetArrayLength() > 0 &&
                root[0].ValueKind == JsonValueKind.Object)
            {
                foreach (var p in root[0].EnumerateObject())
                    answer.Columns.Add(p.Name);

                foreach (var obj in root.EnumerateArray())
                {
                    var row = new List<object?>();
                    foreach (var col in answer.Columns)
                        row.Add(obj.TryGetProperty(col, out var v) ? CellValue(v) : null);
                    answer.Rows.Add(row);
                }
            }
        }
        catch
        {
            // Not JSON / not tabular — fine, we just show the text answer.
        }
    }

    private static object? CellValue(JsonElement e) => e.ValueKind switch
    {
        JsonValueKind.Number => e.TryGetDouble(out var n) ? n : e.GetRawText(),
        JsonValueKind.String => e.GetString(),
        JsonValueKind.True => true,
        JsonValueKind.False => false,
        JsonValueKind.Null => null,
        _ => e.GetRawText()
    };

    public async ValueTask DisposeAsync()
    {
        if (_mcp is not null) await _mcp.DisposeAsync();
        if (_chat is IDisposable d) d.Dispose();
        _httpClient?.Dispose();
    }
}

/// <summary>
/// Delegating chat client that inspects tool-result messages flowing back
/// through the pipeline and extracts a chartable table from their content.
/// </summary>
internal sealed class TableSniffingChatClient : DelegatingChatClient
{
    private readonly Func<DataAnswer?> _current;

    public TableSniffingChatClient(IChatClient inner, Func<DataAnswer?> current)
        : base(inner) => _current = current;

    public override async Task<ChatResponse> GetResponseAsync(
        IEnumerable<ChatMessage> messages,
        ChatOptions? options = null,
        CancellationToken cancellationToken = default)
    {
        Sniff(messages);
        return await base.GetResponseAsync(messages, options, cancellationToken);
    }

    public override async IAsyncEnumerable<ChatResponseUpdate> GetStreamingResponseAsync(
        IEnumerable<ChatMessage> messages,
        ChatOptions? options = null,
        [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken cancellationToken = default)
    {
        Sniff(messages);
        await foreach (var u in base.GetStreamingResponseAsync(messages, options, cancellationToken))
            yield return u;
    }

    private void Sniff(IEnumerable<ChatMessage> messages)
    {
        var answer = _current();
        if (answer is null || answer.HasTable) return;

        foreach (var m in messages)
        foreach (var c in m.Contents.OfType<FunctionResultContent>())
        {
            var text = c.Result as string ?? c.Result?.ToString();
            if (!string.IsNullOrWhiteSpace(text))
                TalkToDataService.TryExtractTable(text!, answer);
            if (answer.HasTable) return;
        }
    }
}


