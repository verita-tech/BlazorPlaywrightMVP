using System.Collections.Concurrent;

namespace TalkToData.Services;

/// <summary>
/// Coordinates the OAuth authorization-code round trip between the MCP client
/// (which needs an auth code) and the browser (which lands on /oauth/callback).
///
/// Flow:
///  1. MCP SDK calls RequestAuthorizationAsync(authUrl) with Metabase's consent URL.
///  2. We store a pending TaskCompletionSource keyed by the OAuth `state`, and
///     hand the consent URL to the UI so it can redirect the user's browser.
///  3. Metabase redirects back to /oauth/callback?code=...&state=...&iss=...
///  4. CompleteAuthorization(...) resolves the TCS; the SDK continues the flow.
/// </summary>
public sealed class MetabaseOAuthCoordinator
{
    public sealed record AuthResult(string Code, string? State, Uri? Issuer);

    private readonly ConcurrentDictionary<string, TaskCompletionSource<AuthResult>> _pending = new();

    // Raised when a consent URL is ready; the Blazor page subscribes and redirects.
    public event Func<Uri, Task>? OnConsentUrlReady;

    public async Task<AuthResult> WaitForCodeAsync(Uri authorizationUrl, string state, CancellationToken ct)
    {
        var tcs = new TaskCompletionSource<AuthResult>(TaskCreationOptions.RunContinuationsAsynchronously);
        _pending[state] = tcs;

        if (OnConsentUrlReady is not null)
            await OnConsentUrlReady.Invoke(authorizationUrl);

        using var reg = ct.Register(() => tcs.TrySetCanceled(ct));
        return await tcs.Task;
    }

    public bool CompleteAuthorization(string state, string code, Uri? issuer)
    {
        if (_pending.TryRemove(state, out var tcs))
            return tcs.TrySetResult(new AuthResult(code, state, issuer));
        return false;
    }
}


