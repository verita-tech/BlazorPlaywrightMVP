            </FluentTabs>
        }
    }
}

@code {
    private string _question = "";
    private bool _busy;
    private DataAnswer? _answer;
    private string _activeTab = "chart";
    private string? _consentUrl;

    private sealed record GridRow(object?[] Cells);

    private IQueryable<GridRow> GridRows =>
        (_answer?.Rows ?? new()).Select(r => new GridRow(r.ToArray())).AsQueryable();

    private string GridTemplate =>
        string.Join(" ", Enumerable.Repeat("1fr", _answer?.Columns.Count ?? 1));

    protected override void OnInitialized()
    {
        OAuth.OnConsentUrlReady += HandleConsentUrl;
    }

    private async Task HandleConsentUrl(Uri url)
    {
        _consentUrl = url.ToString();
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await JS.InvokeVoidAsync("window.open", _consentUrl, "_blank", "noopener");
        });
    }

    private async Task Ask()
    {
        if (string.IsNullOrWhiteSpace(_question) || _busy) return;
        _busy = true;
        _answer = null;
        _consentUrl = null;
        try
        {
            _answer = await Data.AskAsync(_question);
            _activeTab = _answer.HasTable ? "chart" : "table";
        }
        finally
        {
            _busy = false;
            _consentUrl = null;
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Ask();
    }

    public void Dispose()
    {
        OAuth.OnConsentUrlReady -= HandleConsentUrl;
    }
}


