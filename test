using TalkToData.Components;
using TalkToData.Services;

var builder = WebApplication.CreateBuilder(args);

builder.Services.AddRazorComponents()
    .AddInteractiveServerComponents();

builder.Services.Configure<OllamaOptions>(builder.Configuration.GetSection("Ollama"));
builder.Services.Configure<MetabaseMcpOptions>(builder.Configuration.GetSection("MetabaseMcp"));

// Singleton: the OAuth callback arrives on a separate HTTP request and must
// reach the same coordinator that the MCP client is waiting on.
builder.Services.AddSingleton<MetabaseOAuthCoordinator>();

// One MCP + chat connection per circuit (user session).
// Fluent UI Blazor requires a default HttpClient registered before AddFluentUIComponents.
builder.Services.AddHttpClient();
builder.Services.AddFluentUIComponents();

builder.Services.AddScoped<TalkToDataService>();

var app = builder.Build();

if (!app.Environment.IsDevelopment())
{
    app.UseExceptionHandler("/Error", createScopeForErrors: true);
    app.UseHsts();
}

app.UseHttpsRedirection();
app.UseAntiforgery();
app.MapStaticAssets();

// OAuth redirect endpoint. Metabase sends the browser here after consent.
app.MapGet("/oauth/callback", (HttpContext ctx, MetabaseOAuthCoordinator oauth) =>
{
    var code = ctx.Request.Query["code"].ToString();
    var state = ctx.Request.Query["state"].ToString();
    var iss = ctx.Request.Query["iss"].ToString();

    if (string.IsNullOrEmpty(code) || string.IsNullOrEmpty(state))
        return Results.Content("<h3>Anmeldung fehlgeschlagen: fehlender Code/State.</h3>", "text/html");

    Uri? issuer = Uri.TryCreate(iss, UriKind.Absolute, out var u) ? u : null;
    var ok = oauth.CompleteAuthorization(state, code, issuer);

    var msg = ok
        ? "<h3>Anmeldung erfolgreich.</h3><p>Du kannst dieses Fenster schlie&szlig;en und zur App zur&uuml;ckkehren.</p>"
        : "<h3>Anmeldung konnte nicht zugeordnet werden.</h3><p>Bitte in der App erneut versuchen.</p>";
    return Results.Content($"<!doctype html><meta charset='utf-8'>{msg}", "text/html");
});

app.MapRazorComponents<App>()
    .AddInteractiveServerRenderMode();

app.Run();


