--------------------------------------------------------------------------------
Ohne .dockerignore werden bin/ und obj/ vom Host in den Build-Context
kopiert. Das ist nicht nur langsam, sondern fuehrt auch zu kaputten
Builds, weil die Host-Artefakte mit denen im Container kollidieren.


================================================================================
4. BlazorApp/Dockerfile
================================================================================

# ---- build ----
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["BlazorApp/BlazorApp.csproj", "BlazorApp/"]
RUN dotnet restore "BlazorApp/BlazorApp.csproj"
COPY . .
WORKDIR "/src/BlazorApp"
RUN dotnet publish "BlazorApp.csproj" -c Release -o /app/publish

# ---- final: statisches Hosting via nginx ----
FROM nginx:alpine AS final
WORKDIR /usr/share/nginx/html
COPY --from=build /app/publish/wwwroot .
COPY BlazorApp/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

--------------------------------------------------------------------------------
Blazor WASM Standalone ist reines Client-Side. Das Publish-Ergebnis unter
publish/wwwroot sind nur statische Dateien (index.html, .wasm, .dll bzw.
.wasm-Bundles, _framework/). Es laeuft KEINE .NET-Runtime im Container --
die laeuft im Browser. Deshalb nginx statt aspnet als Basis-Image.


================================================================================
5. BlazorApp/nginx.conf
================================================================================

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Client-Side-Routing: jeder unbekannte Pfad geht an index.html,
    # sonst 404 beim Reload auf einer Blazor-Route
    location / {
        try_files $uri $uri/ /index.html =404;
    }

    # MIME-Typen fuer WASM -- ohne das laedt die Runtime nicht
    types {
        text/html                             html htm;
        text/css                              css;
        application/javascript                js mjs;
        application/wasm                      wasm;
        application/octet-stream              dll pdb dat blat;
        application/font-woff                 woff;
        font/woff2                            woff2;
        image/svg+xml                         svg;
        image/png                             png;
        application/json                      json;
    }

    # Kompression -- WASM-Payloads sind gross
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_types
        text/css
        text/plain
        application/javascript
        application/json
        application/wasm
        application/octet-stream
        image/svg+xml;

    # Vorkomprimierte Brotli-Dateien aus dem Publish nutzen,
    # falls das ngx_brotli-Modul verfuegbar ist
    # brotli_static on;

    # Framework-Dateien sind content-hashed -> lange cachen
    location /_framework/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html und Konfiguration nie cachen
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /appsettings.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}


