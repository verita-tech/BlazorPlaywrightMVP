--------------------------------------------------------------------------------
ansible/playbook.yml
--------------------------------------------------------------------------------
---
- name: Deploy Metabase via Helm auf Ubuntu (k3s)
  hosts: metabase
  become: true

  tasks:
    # ---------- Basis ----------
    - name: APT Cache aktualisieren
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: 3600

    - name: Basispakete installieren
      ansible.builtin.apt:
        name:
          - curl
          - ca-certificates
          - apt-transport-https
          - gnupg
          - python3-pip
        state: present

    - name: Python kubernetes Lib (fuer Helm-Modul)
      ansible.builtin.pip:
        name:
          - kubernetes>=24.2.0
          - PyYAML
        state: present
        extra_args: --break-system-packages

    # ---------- k3s ----------
    - name: Pruefen ob k3s installiert ist
      ansible.builtin.stat:
        path: /usr/local/bin/k3s
      register: k3s_bin

    - name: k3s installieren
      ansible.builtin.shell: |
        curl -sfL https://get.k3s.io | \
          INSTALL_K3S_VERSION={{ k3s_version }} \
          INSTALL_K3S_EXEC="--write-kubeconfig-mode 644" sh -
      when: not k3s_bin.stat.exists
      args:
        creates: /usr/local/bin/k3s

    - name: Warten bis k3s-Node ready ist
      ansible.builtin.shell: |
        kubectl wait --for=condition=Ready node --all --timeout=180s
      environment:
        KUBECONFIG: /etc/rancher/k3s/k3s.yaml
      changed_when: false

    # ---------- Helm ----------
    - name: Pruefen ob Helm installiert ist
      ansible.builtin.stat:
        path: /usr/local/bin/helm
      register: helm_bin

    - name: Helm installieren
      ansible.builtin.shell: |
        curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
      when: not helm_bin.stat.exists
      args:
        creates: /usr/local/bin/helm

    # ---------- Chart ausrollen ----------
    - name: Chart-Verzeichnis anlegen
      ansible.builtin.file:
        path: "{{ chart_dst }}"
        state: directory
        mode: "0755"

    - name: Helm Chart auf Server kopieren
      ansible.builtin.copy:
        src: "{{ chart_src }}/"
        dest: "{{ chart_dst }}/"
        mode: "0644"
        directory_mode: "0755"

    - name: Namespace anlegen
      kubernetes.core.k8s:
        kubeconfig: /etc/rancher/k3s/k3s.yaml
        api_version: v1
        kind: Namespace
        name: "{{ namespace }}"
        state: present

    - name: Metabase Helm Release deployen
      kubernetes.core.helm:
        kubeconfig: /etc/rancher/k3s/k3s.yaml
        name: "{{ release_name }}"
        chart_ref: "{{ chart_dst }}"
        release_namespace: "{{ namespace }}"
        create_namespace: true
        wait: true
        wait_timeout: 10m
        values:
          image:
            tag: "{{ metabase_image_tag }}"
          metabase:
            siteUrl: "{{ metabase_site_url }}"
            encryptionSecretKey: "{{ metabase_encryption_key }}"
          postgres:
            password: "{{ postgres_password }}"
            storageClass: "local-path"
          ingress:
            enabled: true
            className: traefik
            host: "{{ metabase_host }}"

    - name: Status ausgeben
      ansible.builtin.shell: |
        kubectl -n {{ namespace }} get pods,svc,ingress
      environment:
        KUBECONFIG: /etc/rancher/k3s/k3s.yaml
      register: mb_status
      changed_when: false

    - name: Deployment-Status
      ansible.builtin.debug:
        var: mb_status.stdout_lines


