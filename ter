--------------------------------------------------------------------------------
charts/metabase/Chart.yaml
--------------------------------------------------------------------------------
apiVersion: v2
name: metabase
description: Metabase self-service BI
type: application
version: 1.0.0
appVersion: "0.62.4.3"


--------------------------------------------------------------------------------
charts/metabase/values.yaml
--------------------------------------------------------------------------------
image:
  repository: metabase/metabase
  tag: "v0.62.4.3"
  pullPolicy: IfNotPresent

replicaCount: 1

metabase:
  siteUrl: "https://metabase.example.com"
  javaOpts: "-Xmx2g"
  # Encryption key fuer gespeicherte DB-Credentials (openssl rand -base64 32)
  encryptionSecretKey: "CHANGE_ME_BASE64_32"

# Interne App-Datenbank (Metabase Metadaten)
postgres:
  enabled: true
  image: postgres:16-alpine
  database: metabase
  username: metabase
  password: "CHANGE_ME_DB_PASSWORD"
  storageClass: "local-path"
  storageSize: 10Gi

service:
  type: ClusterIP
  port: 3000

ingress:
  enabled: true
  className: traefik
  host: metabase.example.com
  tls:
    enabled: false
    secretName: metabase-tls

resources:
  requests:
    cpu: 500m
    memory: 1Gi
  limits:
    cpu: "2"
    memory: 3Gi

nodeSelector: {}
tolerations: []
affinity: {}


